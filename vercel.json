{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "server/vercel.js": {
      "includeFiles": "server/**",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/vercel.js" },
    { "source": "/health", "destination": "/server/vercel.js" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
