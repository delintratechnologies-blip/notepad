# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Only VITE_-prefixed vars are exposed to the browser bundle.

# Base URL for API calls. Leave as /api when the frontend and backend are
# served from the same origin (local dev proxy, or the Vercel deployment).
VITE_API_URL=/api

# Stripe publishable key (pk_test_... / pk_live_...). Safe to expose to the
# browser. Required for the guest payment flow on confirmed bookings.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
