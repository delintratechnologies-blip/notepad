# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/castreach?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_another_64_char_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Client ────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform commission in basis points (1500 = 15%)
PLATFORM_FEE_BPS=1500

# ── Daily.co (recording rooms) ────────────────────────────────────────────────
DAILY_API_KEY=your_daily_api_key
# Optional: HMAC secret to verify Daily recording webhooks (/api/webhooks/daily)
DAILY_WEBHOOK_SECRET=

# ── Anthropic (AI topic suggestions) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Supabase Storage (file uploads) ─────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJh...
